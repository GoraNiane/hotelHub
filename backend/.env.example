# ==================================================
# Teranga Palace Hotel - Backend Environment Variables
# ==================================================

# Server Port
PORT=5000

# Database Connection (MySQL / MariaDB or PostgreSQL with appropriate Prisma provider)
DATABASE_URL="mysql://username:password@localhost:3306/teranga_hotel"

# JWT Authentication
JWT_SECRET="your_secure_random_jwt_secret_key_here"
JWT_EXPIRES_IN="24h"

# CORS Configuration (comma-separated origins, or * in dev)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,https://terangapalace.com"

# Cloudinary Setup (Optional for cloud media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
